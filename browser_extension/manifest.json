{
  "manifest_version": 3,
  "name": "Maximo Desktop · Acciones de OT",
  "version": "0.1.0",
  "description": "Acciones de la OT y seguimiento en el panel lateral de Edge.",
  "permissions": [
    "storage",
    "scripting",
    "downloads",
    "sidePanel"
  ],
  "host_permissions": [
    "https://eam.indraweb.net/maximo/*"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://eam.indraweb.net/maximo/*"
      ],
      "js": [
        "workflow_logic.js",
        "content.js",
        "panel_content.js"
      ],
      "run_at": "document_idle",
      "css": [
        "panel_content.css"
      ]
    }
  ],
  "action": {
    "default_title": "Abrir Maximo Desktop en el panel lateral",
    "default_icon": {
      "16": "icons/md-16.png",
      "24": "icons/md-24.png",
      "32": "icons/md-32.png",
      "48": "icons/md-48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "key": "",
  "icons": {
    "16": "icons/md-16.png",
    "32": "icons/md-32.png",
    "48": "icons/md-48.png",
    "128": "icons/md-128.png"
  }
}
